{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*", "server.js", "api/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
